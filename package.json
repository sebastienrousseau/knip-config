{
  "name": "@sebastienrousseau/knip-config",
  "version": "0.0.7",
  "description": "Shareable Knip configuration rules for finding unused files, dependencies, and exports",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/knip-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/knip-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/knip-config/issues"
  },
  "keywords": [
    "knip",
    "knip-config",
    "unused-files",
    "dead-code",
    "dependencies"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "knip-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js",
    "validate": "knip --config index.cjs --no-exit-code"
  },
  "peerDependencies": {
    "knip": ">=5.0.0"
  },
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.7",
    "knip": "^6.34.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "configKit": {
    "shape": "object",
    "presets": [],
    "nativeToolchain": "knip"
  }
}
